# Real local environment file - not shared, not a template. See .env.example for documented options.

OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o-2024-08-06
DATABASE_URL=sqlite:///./storage/entities.db
UPLOAD_DIR=./storage/uploads
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

OCR_MIN_CHARS_BEFORE_FALLBACK=20
OCR_RASTER_DPI=300

LLM_CHUNK_MAX_CHARS=24000
LLM_MAX_RETRY_ATTEMPTS=3
LLM_RETRY_WAIT_MIN_SECONDS=2
LLM_RETRY_WAIT_MAX_SECONDS=20

MIN_PLAUSIBLE_INCORPORATION_YEAR=1800
RAW_TEXT_PREVIEW_CHARS=4000
